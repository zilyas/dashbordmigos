// Store Management Dashboard — Prisma schema
// Multi-tenant: every store-owned entity carries a storeId and is fully isolated per Store.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  MANAGER
  SELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApiClientStatus {
  ACTIVE
  REVOKED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum MovementType {
  IN
  OUT
  RETURN
  ADJUSTMENT
  SUPPLIER_DELIVERY
  MANUAL_EDIT
}

/// Lifecycle of a ProductBatch (Phase 4a foundation — dormant). ACTIVE = sellable,
/// DEPLETED = stock hit 0, EXPIRED = past its expiry date, ARCHIVED = manually
/// retired. Set by future operational phases; nothing writes these yet.
enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  ARCHIVED
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  PACKAGING
  SHIPPING
  ADVERTISING
  TRANSPORT
  OTHER
}

enum NotificationType {
  LOW_STOCK
  NEW_SALE
  SYSTEM
  USER
  NEW_MESSAGE
  NEW_ANNOUNCEMENT
  SELLER_ADDED
  MANAGER_ASSIGNED
  PASSWORD_CHANGED
  STORE_CREATED
  SYSTEM_ALERT
  EXPIRING_STOCK
  EXPIRED_STOCK
}

enum BackupStatus {
  COMPLETED
  FAILED
}

// ---------- Models ----------

model Store {
  id                  String      @id @default(cuid())
  name                String
  code                String      @unique
  currency            String      @default("MAD")
  taxRate             Decimal     @default(0) @db.Decimal(5, 2)
  allowSellerViewCost Boolean     @default(false)
  address             String?
  city                String?
  country             String?
  phone               String?
  email               String?
  logo                String?
  status              StoreStatus @default(ACTIVE)
  /// IANA timezone identifier (e.g. "Africa/Casablanca"). Used for date-only
  /// business comparisons like batch expiry — never store a fixed UTC offset,
  /// as that ignores daylight-saving rules. Defaults to UTC (Phase 4c1).
  timezone            String      @default("UTC")
  /// Per-store feature flags for optional multi-vertical extensions. Shape:
  /// { units_enabled, custom_variant_axes_enabled, category_attributes_enabled,
  /// expiry_batch_enabled, storefront_api_enabled } — all default false
  /// (see src/lib/features.ts).
  features            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  users                        User[]
  products                     Product[]
  productVariants              ProductVariant[]
  categories                   Category[]
  categoryAttributeDefinitions CategoryAttributeDefinition[]
  variantAxisDefinitions       VariantAxisDefinition[]
  sizes                        Size[]
  colors                       Color[]
  suppliers                    Supplier[]
  sales                        Sale[]
  expenses                     Expense[]
  inventoryMovements           InventoryMovement[]
  productBatches               ProductBatch[]
  notifications                Notification[]
  activityLogs                 ActivityLog[]
  conversations                Conversation[]
  announcements                Announcement[]
  apiClients                   ApiClient[]
  invoiceSequence              InvoiceSequence?

  @@index([status])
  @@map("stores")
}

/// Per-store atomic invoice-number counter. `nextValue` is taken and advanced
/// in one statement — `upsert` with `update: { nextValue: { increment: 1 } }`
/// compiles to a single row-locked `UPDATE ... RETURNING` (or, for a store's
/// very first sale, `INSERT ... ON CONFLICT DO UPDATE`) — so two concurrent
/// sales for the same store can never read the same "next" number the way the
/// old `sale.count() + 1` read-then-write could. A sale that rolls back after
/// taking a number leaves a gap in the sequence; that is fine and expected.
/// A DUPLICATE invoice number is what must never happen, and
/// `Sale.@@unique([storeId, invoiceNumber])` remains as the last line of
/// defence in case this invariant is ever broken by a future change.
model InvoiceSequence {
  storeId   String @id
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  nextValue Int    @default(1)

  @@map("invoice_sequences")
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  passwordHash        String
  role                Role       @default(SELLER)
  storeId             String?
  store               Store?     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdById         String?
  createdBy           User?      @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers        User[]     @relation("UserCreatedBy")
  phone               String?
  avatar              String?
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastLogin           DateTime?

  productsCreated     Product[]            @relation("ProductCreatedBy")
  sales               Sale[]
  inventoryMovements  InventoryMovement[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  userSessions        UserSession[]
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]
  twoFactorCredential TwoFactorCredential?
  backupRecords       BackupRecord[]

  conversationsCreated     Conversation[]            @relation("ConversationCreatedBy")
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  readReceipts             ReadReceipt[]
  announcementsCreated     Announcement[]            @relation("AnnouncementCreatedBy")
  announcementRecipients   AnnouncementRecipient[]
  apiClientsActedFor       ApiClient[]              @relation("ApiClientActor")

  @@index([storeId])
  @@index([role])
  @@map("users")
}

model Product {
  id                   String        @id @default(cuid())
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sku                  String
  barcode              String?
  name                 String
  slug                 String
  description          String?
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type                 String?
  size                 String?
  color                String?
  fabricationPrice     Decimal       @db.Decimal(10, 2)
  sellingPrice         Decimal       @db.Decimal(10, 2)
  profitMargin         Decimal       @default(0) @db.Decimal(6, 2)
  /// Decimal(12,3) so unit-priced verticals can hold fractional stock (0.5 kg).
  /// For piece products this is always a whole number (enforced server-side).
  stock                Decimal       @default(0) @db.Decimal(12, 3)
  /// Low-stock threshold. Decimal(12,3) so decimal products can set a
  /// fractional threshold; whole numbers for piece products (enforced server-side).
  minimumStock         Decimal       @default(5) @db.Decimal(12, 3)
  status               ProductStatus @default(ACTIVE)
  /// Unit of measure label (piece, kg, g, L, pack, ...). Display/label only in
  /// Phase 1a; decimal quantity handling arrives in Phase 1b. Defaults to piece.
  unit                 String?       @default("piece")
  /// When true (and the store has units_enabled) this product may be sold in
  /// decimal quantities. Enforced in Phase 1b; stored now so the flag is ready.
  allowDecimalQuantity Boolean       @default(false)
  /// When true this product sells through ProductVariant rows (variant-enabled
  /// mode). Simple products leave this false and use the columns above.
  hasVariants          Boolean       @default(false)
  /// Phase 4a foundation (DORMANT). Opts a product into batch/lot tracking, where
  /// ProductBatch rows become the authoritative stock detail and `stock` above is
  /// kept as a consistent aggregate cache. Defaults false; no action or UI may
  /// flip it until the coherent operational release (receiving + FEFO sale
  /// allocation + batch-aware returns/deletion) ships. See
  /// .ai/phase4-expiry-batch-design.md.
  trackBatch           Boolean       @default(false)
  /// Phase 4a foundation (DORMANT). Adds per-batch expiry dates. Implies
  /// trackBatch (enforced by isBatchTrackingConfigurationValid in
  /// src/lib/batches.ts). Defaults false; dormant like trackBatch.
  trackExpiry          Boolean       @default(false)
  /// Free-form vertical-specific attributes (e.g. material, brand, warranty).
  metadata             Json?
  createdById          String
  createdBy            User          @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  attributeValues    ProductAttributeValue[]
  batches            ProductBatch[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, name])
  @@index([categoryId])
  @@index([storeId, trackBatch])
  /// Cursor index for the public delta-sync endpoint (GET /api/v1/stock?updatedSince=).
  @@index([storeId, updatedAt])
  @@map("products")
}

/// One sellable variant of a variant-enabled Product. Size/Color are optional
/// so non-clothing verticals can still use variants keyed on other axes.
/// Price/cost overrides are null when the parent Product's price/cost applies.
model ProductVariant {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId           String?
  size             Size?    @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  colorId          String?
  color            Color?   @relation(fields: [colorId], references: [id], onDelete: SetNull)
  sku              String
  barcode          String?
  /// Overrides Product.sellingPrice when set.
  sellingPrice     Decimal? @db.Decimal(10, 2)
  /// Overrides Product.fabricationPrice when set.
  fabricationPrice Decimal? @db.Decimal(10, 2)
  stock            Decimal  @default(0) @db.Decimal(12, 3)
  isActive         Boolean  @default(true)
  imageUrl         String?
  /// Custom variant axis values (Phase 3), shaped `{ [axisKey]: "value" }`
  /// keyed by VariantAxisDefinition.key — e.g. `{ "storage": "256GB" }`.
  ///
  /// Deliberately JSON rather than a relational per-axis-value table (unlike
  /// Phase 2's `ProductAttributeValue`): axis values are simple free-text
  /// labels used only for variant identification/display, needing no typed
  /// validation or cross-product querying, so a JSON blob avoids an explosion
  /// of joins. `sizeId`/`colorId` above stay as the built-in axes.
  axisValues       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images             ProductImage[]
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  batches            ProductBatch[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
  /// Cursor index for the public delta-sync endpoint (GET /api/v1/stock?updatedSince=).
  @@index([storeId, updatedAt])
  @@map("product_variants")
}

/// A store-defined custom variant axis (Phase 3), e.g. "Storage", "Voltage".
/// Gated by the store's `custom_variant_axes_enabled` flag. Values live on
/// `ProductVariant.axisValues` keyed by `key`.
model VariantAxisDefinition {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  key       String
  label     String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([storeId])
  @@map("variant_axis_definitions")
}

/// Store-scoped size vocabulary (S, M, L, 42, ...). Referenced by variants.
model Size {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  variants ProductVariant[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("sizes")
}

/// Store-scoped color vocabulary. `hex` is optional swatch metadata.
model Color {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      String
  hex       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  variants ProductVariant[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("colors")
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Optional: when set, this image belongs to a specific variant rather than
  /// the product as a whole (variant image override).
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model Category {
  id                   String                        @id @default(cuid())
  storeId              String
  store                Store                         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name                 String
  slug                 String
  description          String?
  isActive             Boolean                       @default(true)
  /// Optional parent for a shallow category tree. Self-referential, store-scoped.
  parentId             String?
  parent               Category?                     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             Category[]                    @relation("CategoryTree")
  /// Vertical-specific flags/attributes. `clothing: true` opts a category into
  /// the variant-management UI.
  metadata             Json?
  products             Product[]
  attributeDefinitions CategoryAttributeDefinition[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@map("categories")
}

/// Optional per-category attribute schema (Phase 2), gated by the store's
/// `category_attributes_enabled` flag. Structured & typed — deliberately NOT
/// stored in `Category.metadata` (which stays reserved for `isClothing`).
model CategoryAttributeDefinition {
  id         String        @id @default(cuid())
  storeId    String
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       AttributeType @default(TEXT)
  /// Allowed values when `type = SELECT`, stored as a JSON string array.
  options    Json?
  position   Int           @default(0)
  required   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  values ProductAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId])
  @@index([storeId])
  @@map("category_attribute_definitions")
}

/// A product's value for one of its category's attribute definitions. Value is
/// stored as a string and coerced per the definition's type (see
/// `src/lib/attributes.ts`).
model ProductAttributeValue {
  id           String                      @id @default(cuid())
  productId    String
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   CategoryAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([productId, definitionId])
  @@index([productId])
  @@index([definitionId])
  @@map("product_attribute_values")
}

model Supplier {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@map("suppliers")
}

/// Monetary fields hold the CURRENT (net-of-returns) value, not the original
/// amount charged. A return recalculates them in place, so every revenue and
/// profit aggregate across the app reports net figures without each query
/// needing to know returns exist. The original amount is recoverable as
/// `total + refundedTotal`, and per-item history lives in
/// `SaleItem.returnedQuantity`.
model Sale {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  invoiceNumber String
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  customerName  String?
  customerPhone String?
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  netProfit     Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  /// Cumulative amount refunded to the customer across all returns on this
  /// sale. Display/reporting only — `total` is already net of it.
  refundedTotal Decimal       @default(0) @db.Decimal(10, 2)
  /// Set when this sale came in through the public API (POST /api/v1/orders)
  /// instead of the POS. Null for in-store sales.
  apiClientId   String?
  apiClient     ApiClient?    @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  /// Caller-supplied de-duplication token for API orders. `@@unique([storeId,
  /// idempotencyKey])` is safe here because Postgres treats NULLs as distinct,
  /// so the thousands of POS sales that have no key never collide with each
  /// other. A retried webhook replays the same key and gets the original sale
  /// back instead of decrementing stock a second time.
  idempotencyKey String?
  /// SHA-256 of the meaningful order body that first used `idempotencyKey`.
  /// The key alone only proves "same key", not "same request": a storefront
  /// that recycles a key for a different basket would otherwise get the first
  /// order's receipt back and never learn its new order was dropped. A mismatch
  /// is answered with 409 `idempotency_key_reused`. Null for POS sales.
  idempotencyHash String?
  items         SaleItem[]
  createdAt     DateTime      @default(now())

  @@unique([storeId, invoiceNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([sellerId])
  @@map("sales")
}

model SaleItem {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  /// Set when the sold line is a specific variant; null for simple products.
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  /// Human-readable variant snapshot at sale time (e.g. "M / Noir"), so the
  /// invoice stays correct even if the variant is later renamed or removed.
  variantLabel     String?
  /// Units originally sold — never reduced by a return, so the invoice can
  /// still show what the customer actually bought. Decimal(12,3) for fractional
  /// units (0.5 kg); whole numbers for piece products (enforced server-side).
  quantity         Decimal         @db.Decimal(12, 3)
  /// Units given back so far; always <= quantity. Units still kept by the
  /// customer are `quantity - returnedQuantity`.
  returnedQuantity Decimal         @default(0) @db.Decimal(12, 3)
  sellingPrice     Decimal         @db.Decimal(10, 2)
  fabricationPrice Decimal         @db.Decimal(10, 2)
  profit           Decimal         @db.Decimal(10, 2)

  /// Phase 4a foundation (DORMANT). Which batch(es) this line drew from, for
  /// future FEFO allocation and exact return restoration. No rows are written
  /// until the operational release.
  allocations SaleItemBatchAllocation[]

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
  @@map("sale_items")
}

model InventoryMovement {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  /// Set when the movement targets a specific variant's stock.
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  type        MovementType
  /// Signed quantity (negative for OUT). Decimal(12,3) for fractional units.
  quantity    Decimal         @db.Decimal(12, 3)
  note        String?
  /// Phase 4a foundation (DORMANT). Attributes a movement to a specific batch,
  /// for future batch history reporting. Null for all existing/untracked movements.
  batchId     String?
  batch       ProductBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@index([batchId])
  @@index([createdAt])
  @@map("inventory_movements")
}

/// Phase 4a foundation (DORMANT — no rows created until the operational release).
/// A received lot of a tracked product/variant. When a product opts in
/// (`trackBatch`), these rows become the authoritative stock detail and the
/// product/variant `stock` column is kept as a consistent aggregate cache
/// (invariant: Σ ACTIVE-batch stock == aggregate). Batch code is unique per
/// (store, product, optional variant) — enforced by two PARTIAL unique indexes
/// added in the migration SQL (a plain compound @@unique can't be used because
/// PostgreSQL treats NULL variantId values as distinct). See
/// .ai/phase4-expiry-batch-design.md.
model ProductBatch {
  id         String          @id @default(cuid())
  storeId    String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Null for product-level batches; set for variant-level batches.
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchCode  String
  /// Date-only (no time) to avoid time-zone ambiguity; null = batch/lot tracking
  /// without an expiry date.
  expiryDate DateTime?       @db.Date
  receivedAt DateTime        @default(now())
  stock      Decimal         @default(0) @db.Decimal(12, 3)
  /// Per-lot cost, reporting/stock-value metadata only. Does NOT feed
  /// SaleItem cost/profit (those keep their own snapshots).
  costPrice  Decimal?        @db.Decimal(10, 2)
  status     BatchStatus     @default(ACTIVE)
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  allocations SaleItemBatchAllocation[]
  movements   InventoryMovement[]

  @@index([storeId])
  @@index([productId, variantId, status])
  @@index([storeId, expiryDate])
  @@map("product_batches")
}

/// Phase 4a foundation (DORMANT). Records how many units of a SaleItem were drawn
/// from a specific batch, so future returns/deletions can restore the exact
/// original lot. `returnedQuantity` mirrors SaleItem.returnedQuantity semantics.
/// The batch relation is onDelete: Restrict so a batch referenced by sold history
/// can never be hard-deleted; the saleItem relation cascades with the sale line.
model SaleItemBatchAllocation {
  id               String       @id @default(cuid())
  saleItemId       String
  saleItem         SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batchId          String
  batch            ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity         Decimal      @db.Decimal(12, 3)
  returnedQuantity Decimal      @default(0) @db.Decimal(12, 3)
  /// Phase 5 audit marker: true when this allocation was drawn from an EXPIRED
  /// batch via a Manager expired-sale override. Append-only; never affects
  /// quantity/returnedQuantity semantics.
  fromExpired      Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([saleItemId])
  @@index([batchId])
  @@map("sale_item_batch_allocations")
}

model Expense {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(10, 2)
  note      String?
  createdAt DateTime        @default(now())

  @@index([storeId])
  @@index([createdAt])
  @@map("expenses")
}

model ActivityLog {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String           @id @default(cuid())
  storeId   String?
  store     Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId    String
  /// Cascades: a notification is ephemeral UI state with no historical or
  /// audit value, so it must never be the thing that blocks deleting a user.
  /// Records that DO carry history — sales, activity logs, products created,
  /// messages — deliberately stay RESTRICT, which turns a delete into a
  /// deactivation instead (see isForeignKeyConstraintError callers).
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  /// Idempotency key for machine-generated alerts (e.g. expiry sweeps). Null for
  /// ordinary notifications. A PARTIAL unique index (userId, dedupeKey) WHERE
  /// dedupeKey IS NOT NULL — added in the migration SQL — lets a repeated/
  /// concurrent sweep skip duplicates while keeping all null-key rows unique-free.
  dedupeKey String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([storeId])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Revocation ledger for JWT sessions. The JWT itself carries a `sid` claim
/// matching `tokenId` here; every Node-runtime request re-checks this row
/// via getSessionContext() so "logout everywhere" / "terminate session" are
/// possible despite the session strategy being stateless JWTs.
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId       String    @unique
  ipAddress     String?
  userAgent     String?
  browser       String?
  os            String?
  rememberMe    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId])
  @@map("user_sessions")
}

/// Every login attempt, successful or not — brute-force visibility and the
/// source of truth for rate limiting / lockouts.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  failReason String?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Last-N password hashes, checked on password change/reset to block reuse.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("password_history")
}

model TwoFactorCredential {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String
  enabled    Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  recoveryCodes RecoveryCode[]

  @@map("two_factor_credentials")
}

model RecoveryCode {
  id          String              @id @default(cuid())
  twoFactorId String
  twoFactor   TwoFactorCredential @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([twoFactorId])
  @@map("recovery_codes")
}

model BackupRecord {
  id          String       @id @default(cuid())
  filename    String
  sizeBytes   Int
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  status      BackupStatus
  createdAt   DateTime     @default(now())

  @@map("backup_records")
}

// ---------- Communication (Part 2) ----------

enum AnnouncementScope {
  PLATFORM
  STORE
}

/// A DM or group thread. `storeId` is null for Super-Admin conversations that
/// span the whole platform (e.g. messaging a specific Manager directly).
model Conversation {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  isGroup     Boolean  @default(false)
  title       String?
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([storeId])
  @@map("conversations")
}

/// Membership + read cursor. `lastReadAt` alone is enough to compute an
/// unread badge without a receipt row per message per participant.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  attachments  MessageAttachment[]
  readReceipts ReadReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// Schema only this phase — no upload UI wired up yet (future-ready, per spec).
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model ReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("read_receipts")
}

/// Platform-wide (Super Admin) or store-scoped (Manager) broadcast.
/// Recipient rows are fanned out eagerly at creation time — store sizes are
/// small enough that this is simpler and cheap compared to a lazy read model.
model Announcement {
  id          String            @id @default(cuid())
  scope       AnnouncementScope
  storeId     String?
  store       Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  title       String
  body        String
  createdById String
  createdBy   User              @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  recipients AnnouncementRecipient[]

  @@index([storeId])
  @@index([scope])
  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_recipients")
}

/// A machine credential for one store, used by external e-commerce storefronts
/// to read the catalog and post orders through `/api/v1/**`.
///
/// Why this is not a `User` with a `Role`: the RBAC roles carry destructive
/// permissions (`sale.delete`, `product.delete`, `seller.manage`). A leaked
/// storefront key must never be able to express those, so scopes live in their
/// own vocabulary and are checked by `requireScope()` in `src/lib/api/auth.ts`.
///
/// The secret half of the key is never stored — only `keyHash` (SHA-256 of the
/// full key). `keyPrefix` is the public, indexed lookup handle.
model ApiClient {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  /// Public, non-secret lookup handle, e.g. "sk_live_3f9a1c22". Unique so the
  /// row is found by index rather than by scanning every hash.
  keyPrefix   String          @unique
  /// SHA-256 hex of the full key. A 256-bit random key needs no memory-hard KDF;
  /// Argon2 here would make every API request pay ~19 MiB of hashing.
  keyHash     String
  /// Least-privilege scopes, e.g. ["products:read", "orders:create"].
  scopes      String[]
  status      ApiClientStatus @default(ACTIVE)
  /// The real user every API-created Sale, InventoryMovement and ActivityLog is
  /// attributed to. Those relations are non-nullable and a machine caller has no
  /// session, so the key carries its own actor (chosen at mint time).
  actorUserId String
  actor       User            @relation("ApiClientActor", fields: [actorUserId], references: [id])
  /// Hard stop. Non-null forces rotation to actually happen.
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sales Sale[]

  @@index([storeId, status])
  @@map("api_clients")
}
