# ─────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without these.
# src/instrumentation.ts validates them once at server startup and aborts
# boot listing every missing or malformed one. Everything below the three
# REQUIRED vars is optional or feature-gated: leave it blank and the app
# still runs (with that feature off).
#   REQUIRED: DATABASE_URL, AUTH_SECRET, ENCRYPTION_KEY
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL — Neon or any Postgres)  [REQUIRED: DATABASE_URL]
# ─────────────────────────────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (unpooled) connection — used by Prisma migrations. Often the same host
# without the -pooler segment. Falls back to DATABASE_URL if your provider has
# no separate direct URL.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ─────────────────────────────────────────────────────────────
# Auth (NextAuth v5)  [REQUIRED: AUTH_SECRET]
# ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-32-byte-base64-secret"

# ─────────────────────────────────────────────────────────────
# Seeding (prisma db seed)
# ─────────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL="superadmin@store.dev"
SEED_SUPER_ADMIN_NAME="Platform Owner"
# If unset, a one-time random password is generated and printed once.
SEED_SUPER_ADMIN_PASSWORD=""
# Demo data (store/manager/seller/sizes/colors/variant product). Set to "false"
# to seed only the super admin.
SEED_DEMO="true"
# Password for the demo manager and seller. If unset, the seed generates a
# random password and prints it once. Never ship a real value here.
SEED_DEMO_PASSWORD="CHANGE_ME"

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (product & variant image storage)
# Leave ALL of these blank to fall back to local-disk uploads
# (public/uploads). Set all of them to store images in R2.
# ─────────────────────────────────────────────────────────────
# R2 → Overview → Account ID (also the sub-domain of the S3 endpoint).
R2_ACCOUNT_ID=""
# R2 → Manage R2 API Tokens → "Object Read & Write" token.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket name (create it in the R2 dashboard first).
R2_BUCKET="dashboard"
# Public read base URL: the bucket's r2.dev "Public Development URL" or a
# connected custom domain. NO trailing slash.
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
# Optional: only set to override the derived S3 endpoint. HOST ONLY, no bucket path.
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# ─────────────────────────────────────────────────────────────
# Rate limiting (optional — multi-replica deployments only)
# ─────────────────────────────────────────────────────────────
# The login / password-reset rate limiter is IN-MEMORY by default, which is
# correct for a single app instance. If you run more than one replica, that
# counter isn't shared, so set BOTH of these to switch to a shared Upstash
# Redis (REST) backend. Leave both blank to keep the in-memory limiter.
# Upstash console → your database → "REST API": copy the URL and token.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Expiry sweep cron (optional — batch/expiry tracking only)
# ─────────────────────────────────────────────────────────────
# Secret that protects POST /api/cron/expiry (the daily expiry status +
# notification sweep). Leave BLANK to disable the endpoint entirely (it returns
# 503). When set, your deployment scheduler must call the route once a day with
# header `Authorization: Bearer <this value>`. Sale eligibility never depends on
# this sweep — it is a status/notification convenience only.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EXPIRY_CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# Scheduled database backup (optional)
# ─────────────────────────────────────────────────────────────
# Secret that protects POST /api/cron/backup (full DB dump + retention prune).
# Leave BLANK to disable the endpoint entirely (it returns 503). When set, your
# deployment scheduler must call the route on a schedule (daily is typical) with
# header `Authorization: Bearer <this value>`. The backup is attributed to the
# oldest active SUPER_ADMIN, since a cron call carries no session.
# Leaving it blank is a SILENT no-backups state: the route fails closed and
# nothing is alerted, so startup logs a notice. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_CRON_SECRET=""
# COMPLETED backups older than this many days are deleted (file + record) after
# each successful scheduled run. FAILED records are kept as an audit trail.
# Defaults to 30. Pruning only ever runs after a backup succeeds.
BACKUP_RETENTION_DAYS="30"
# If R2 is configured above, ALSO set a bucket lifecycle rule on the `backups/`
# prefix in the Cloudflare dashboard. This app deletes R2 objects best-effort
# only; the lifecycle rule is what durably bounds off-site storage.

# ─────────────────────────────────────────────────────────────
# Encryption  [REQUIRED: ENCRYPTION_KEY]
# AES-256-GCM key for TWO things: 2FA (TOTP) secrets at rest, and backup files.
# Without it, 2FA enrolment, 2FA sign-in and every backup fail. It must decode
# to EXACTLY 32 bytes — a 31-byte key is rejected at boot.
# Rotating this value makes existing encrypted TOTP secrets and existing
# backup files undecryptable, so treat it as permanent once users have enrolled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="your-32-byte-base64-key-here"

# ─────────────────────────────────────────────────────────────
# Logging (optional)
# ─────────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── E2E tests (Playwright) ──
# Credentials of an existing account to sign in with. The seeder does NOT reset
# an existing Super Admin password, so SEED_SUPER_ADMIN_PASSWORD may not match
# the database. Leave unset to skip the authenticated E2E suites.
E2E_EMAIL=""
E2E_PASSWORD=""
# Override when the dev server is not on port 3000.
E2E_BASE_URL="http://localhost:3000"
